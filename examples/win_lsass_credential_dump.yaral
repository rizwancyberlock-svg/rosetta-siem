rule win_lsass_credential_dump {
  meta:
    author = "Rizwan Ahmed"
    description = "Command lines associated with dumping LSASS process memory: comsvcs.dll MiniDump (LOLBin), Sysinternals ProcDump against lsass, and Mimikatz sekurlsa modules. A successful dump exposes NTLM hashes, Kerberos tickets and sometimes cleartext credentials."
    severity = "CRITICAL"
    status = "stable"
    platform = "Windows"
    data_source = "EDR / Sysmon EID 1 / Windows Security EID 4688"
    mitre_attack_tactic = "Credential Access"
    mitre_attack_technique = "T1003.001"
    false_positives = "Rare. Authorized crash-dump collection by IT support or incident responders. Confirm with the change/IR ticket."
    reference = "https://attack.mitre.org/techniques/T1003/001/"
    created = "2026-11-26"
    version = "1.0"

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    (
      $proc.target.process.command_line = /comsvcs(\.dll)?[\s,]+(#\s*\+?0*24|MiniDump)/ nocase or
      $proc.target.process.command_line = /procdump(64)?(\.exe)?\s.*-ma\s.*lsass/ nocase or
      $proc.target.process.command_line = /sekurlsa::(logonpasswords|minidump|ekeys|pth)/ nocase
    )

  outcome:
    $risk_score = 95
    $principal_hostname = $proc.principal.hostname
    $principal_user = $proc.principal.user.userid
    $parent_process = $proc.principal.process.file.full_path
    $command_line = $proc.target.process.command_line

  condition:
    $proc
}
